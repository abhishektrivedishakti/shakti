  updatedAt          DateTime @updatedAt

  @@index([staffUserId])
  @@index([date])
  @@index([type])
  @@index([approvalStatus])
}

// ─── Phase 9: Fleet Dispatch Pro ──────────────────────────────────────────────

model DispatchProfile {
  id             String   @id @default("default")
  companyName    String   @default("Shakti Travels and Tours")
  tagline        String   @default("")
  gstin          String   @default("")
  pan            String   @default("")
  address        String   @default("")
  supportPhone   String   @default("")
  bookingEmail   String   @default("")
  bankName       String?
  bankAccountNo  String?
  ifscCode       String?
  upiId          String?
  dutySlipTerms  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model DispatchDirectory {
  id         String   @id @default("default")
  /// JSON: ClientDetails[]
  clients    Json     @default("[]")
  /// JSON: BookerDetails[]
  bookers    Json     @default("[]")
  /// JSON: PassengerDetails[]
  passengers Json     @default("[]")
  /// JSON: { vehicleNumber, vehicleModel, vehicleClass }[]
  vehicles   Json     @default("[]")
  /// JSON: { name, phone }[]
  drivers    Json     @default("[]")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model DispatchTariffPackage {
  id            String   @id @default(cuid())
  packageName   String
  category      String   @default("custom_package")
  baseRate      Float    @default(0)
  baseHours     Float    @default(0)
  baseKm        Float    @default(0)
  extraKmRate   Float    @default(0)
  extraHourRate Float    @default(0)
  nightHaltRate Float    @default(0)
  driverWage    Float    @default(0)
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([category])
}

model DispatchBooking {
  id                   String   @id @default(cuid())
  bookingNumber        String
  tenderId             String?
  tenderNumber         String?
  date                 String
  status               String   @default("scheduled")
  /// JSON: ClientDetails
  client               Json
  /// JSON: BookerDetails
  booker               Json
  /// JSON: PassengerDetails
  passenger            Json
  vehicleId            String?
  vehicleNumber        String   @default("")
  vehicleModel         String   @default("")
  vehicleClass         String   @default("")
  driverId             String?
  driverName           String   @default("")
  driverPhone          String   @default("")
  reportingDate        String
  reportingTime        String   @default("")
  releaseDate          String?
  releaseTime          String?
  pickupLocation       String   @default("")
  dropLocation         String   @default("")
  routeStops           String?
  garageOutKm          Float    @default(0)
  garageInKm           Float?
  totalKmRun           Float?
  garageOutTime        String?
  garageInTime         String?
  totalHoursRun        Float?
  /// JSON: DutyTariff
  tariff               Json
  clientInvoiceNumber  String?
  clientPaymentStatus  String   @default("unbilled")
  clientPaidAmount     Float?
  driverPaymentStatus  String   @default("pending")
  driverPaidAmount     Float?
  notes                String?
  createdAt            String   @default("")
  updatedAt            DateTime @updatedAt

  @@index([bookingNumber])
  @@index([date])
  @@index([status])
  @@index([reportingDate])
  @@index([vehicleNumber])
  @@index([clientPaymentStatus])
  @@index([driverPaymentStatus])
}
