model PettyCashTransaction {
  id                 String   @id @default(cuid())
  type               String
  staffUserId        String
  staffUserName      String   @default("")
  date               String
  time               String?
  amount             Float    @default(0)
  category           String?
  vehicleId          String?
  vehicleNumber      String?
  payeeOrVendor      String?
  billSlipNumber     String?
  billPhotoUrl       String?
  notes              String   @default("")
  paymentMode        String   @default("Cash")
  approvalStatus     String   @default("pending_verification")
