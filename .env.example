# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# -----------------------------------------------------------------------------
# Database
# Local default: SQLite file (works out of the box)
DATABASE_URL="file:./dev.db"
#
# Production (Postgres / Neon / Supabase / Railway):
# 1) In prisma/schema.prisma set:  provider = "postgresql"
# 2) Set DATABASE_URL to your Postgres connection string, e.g.:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/shakti?sslmode=require"
# 3) Run: npm run db:push && npm run db:seed
# -----------------------------------------------------------------------------

# Secret for staff JWT sessions — use a long random string in production
JWT_SECRET="change-me-to-a-long-random-secret"

# Uploads
MAX_UPLOAD_BYTES="20971520"

# Cloudflare R2 (optional). When all R2_* vars are set, file uploads use R2.
# Leave blank to keep local /uploads disk storage.
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET=""
# R2_PUBLIC_BASE_URL="https://files.your-domain.com"

# Default admin — login with email + password (run: npm run db:seed)
SEED_ADMIN_NAME="Shakti Admin"
SEED_ADMIN_EMAIL="admin@shakti.com"
SEED_ADMIN_PASSWORD="Password@123"
SEED_ADMIN_MOBILE="9999888877"

# Public app URL (production)
APP_URL="MY_APP_URL"
NODE_ENV="development"
