# GEMINI_API_KEY: Required for Gemini AI API calls (optional for core ERP).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# -----------------------------------------------------------------------------
# Database — PostgreSQL (required for this schema)
# Local: Docker/Postgres on localhost, or any hosted Postgres.
# Production: Neon / RDS / Supabase / Railway, etc.
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/shakti?sslmode=require"

# Secret for staff JWT sessions — use a long random string in production
# Generate: openssl rand -base64 48
JWT_SECRET="change-me-to-a-long-random-secret"

# Uploads
MAX_UPLOAD_BYTES="20971520"

# Cloudflare R2 (optional). When all R2_* vars are set, file uploads use R2.
# Leave blank to keep local /uploads disk storage.
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET=""
# R2_PUBLIC_BASE_URL="https://files.your-domain.com"

# Default admin — login with email + password (run: npm run db:seed)
SEED_ADMIN_NAME="Shakti Admin"
SEED_ADMIN_EMAIL="admin@shakti.com"
SEED_ADMIN_PASSWORD="Password@123"
SEED_ADMIN_MOBILE="9999888877"

# Public app URL
APP_URL="http://localhost:3000"
PORT="3000"
NODE_ENV="development"
