# Copy to /var/www/shakti/.env on the server (never commit).
# Or let scripts/cutover-server.sh generate JWT_SECRET for you.

NODE_ENV=production
PORT=3000
APP_URL=https://YOUR_DOMAIN

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/shakti?sslmode=require

# openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET

MAX_UPLOAD_BYTES=20971520

SEED_ADMIN_NAME=Shakti Admin
SEED_ADMIN_EMAIL=admin@yourdomain.com
SEED_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
SEED_ADMIN_MOBILE=9999888877
